NEXT_PUBLIC_API_URL=https://backend.alteradatasuite.com/

# Paddle Billing checkout (Pricing page CTAs -> Paddle overlay checkout).
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN: Paddle's client-side token (Paddle
#   dashboard -> Developer Tools -> Authentication). Safe to expose in the
#   browser bundle -- distinct from the server-side Paddle API key used by
#   altera-license-server.
# NEXT_PUBLIC_PADDLE_PRICE_MONTHLY / _YEARLY / _LIFETIME: the Paddle Price
#   ID (pri_...) for each plan (Paddle dashboard -> Catalog -> Prices).
#   Must match PADDLE_PRICE_MONTHLY / _YEARLY / _LIFETIME set on
#   altera-license-server so the webhook maps the purchase to the right plan.
# NEXT_PUBLIC_PADDLE_ENVIRONMENT: set to "sandbox" while testing with a
#   sandbox client token + sandbox prices (Paddle.js otherwise targets the
#   production checkout service and a sandbox token gets a 403). Leave
#   unset (or set to "production") once switched to live credentials.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_YEARLY=
NEXT_PUBLIC_PADDLE_PRICE_LIFETIME=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=
